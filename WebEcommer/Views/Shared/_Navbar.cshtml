@using Microsoft.AspNetCore.Http
<!-- Navbar Start -->
<nav class="navbar navbar-expand-lg navbar-dark fixed-top py-lg-0 px-lg-5 wow fadeIn" data-wow-delay="0.1s">
    <a href="@Url.Action("Index", "Home")" class="navbar-brand ms-4 ms-lg-0">
        <h1 class="text-primary m-0">Ecommer</h1>
    </a>
    <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarCollapse">
        <div class="navbar-nav mx-auto p-4 p-lg-0">
            <a href="@Url.Action("Index", "Home")" class="nav-item nav-link">Trang chủ</a>
            <a href="about.html" class="nav-item nav-link">Về chúng tôi</a>
            <a href="service.html" class="nav-item nav-link">Dịch vụ</a>
            <a href="@Url.Action("Index", "Home")" class="nav-item nav-link">Sản phẩm</a>
            <a href="@Url.Action("Index", "Cart")" class="nav-item nav-link">Giỏ hàng</a>
            <div class="nav-item dropdown">
                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Trang</a>
                <div class="dropdown-menu m-0">
                    <a href="team.html" class="dropdown-item">Đội ngũ của chúng tôi</a>
                    <a href="testimonial.html" class="dropdown-item">Đánh giá</a>
                    <a href="404.html" class="dropdown-item">Trang lỗi 404</a>
                </div>
            </div>
            <a href="contact.html" class="nav-item nav-link">Liên hệ</a>
        </div>
    </div>

    <div class=" d-none d-lg-flex ms-auto pe-3">
        <div class="flex-shrink-0 btn-lg-square border border-light rounded-circle me-3">
            <i class="fa fa-phone text-primary"></i>
        </div>
        <div class="ps-3">
            <small class="text-primary mb-0">Call Us</small>
            <p class="text-light fs-5 mb-0">+012 345 6789</p>
        </div>
    </div>

    <div class="ms-3">
        @{
            var hoTen = Context.Session.GetString("HoTen");
        }
        @if (!string.IsNullOrEmpty(hoTen))
        {
            <div class="nav-item dropdown d-inline-block">
                <a class="nav-link dropdown-toggle text-light" href="#" data-bs-toggle="dropdown">Xin chào, @hoTen</a>
                <div class="dropdown-menu dropdown-menu-end">
                    <a class="dropdown-item" href="@Url.Action("Index", "Cart")">Giỏ hàng</a>
                    <a class="dropdown-item" href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                </div>
            </div>
        }
        else
        {
            <a href="@Url.Action("Login", "Account")" class="btn btn-outline-light me-2">Đăng nhập</a>
            <a href="@Url.Action("Register", "Account")" class="btn btn-primary">Đăng ký</a>
        }
    </div>
</nav>
<!-- Navbar End -->