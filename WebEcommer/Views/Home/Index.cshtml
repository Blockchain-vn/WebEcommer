
@model IEnumerable<WebEcommer.Models.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Form Tìm kiếm - TC01, TC02, TC03 -->
<div class="mb-4">
    <form method="get" asp-action="Search" asp-controller="Home" class="d-flex gap-2">
        <input 
            type="text" 
            name="keyword" 
            class="form-control" 
            placeholder="Tìm kiếm sản phẩm..." 
            required 
            minlength="1"
            maxlength="100"
            value="@ViewBag.Keyword" />
        <button type="submit" class="btn btn-primary">
            <i class="fa fa-search"></i> Tìm kiếm
        </button>
    </form>
</div>

<!-- Hiển thị thông báo kết quả tìm kiếm -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fa fa-info-circle"></i> @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hiển thị kết quả tìm kiếm -->
@if (ViewBag.IsSearch)
{
    <div class="mb-3">
        <p class="text-muted">
            Kết quả tìm kiếm cho: <strong>"@ViewBag.Keyword"</strong> - 
            Trang <strong>@ViewBag.Page</strong> / <strong>@ViewBag.TotalPages</strong>
        </p>
    </div>
}

<div class="row g-4">
@if (Model != null)
{
    foreach (var item in Model)
    {
        <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
            <div class="product-item d-flex flex-column bg-white rounded overflow-hidden h-100">
                <div class="text-center p-4">
                    <div class="d-inline-block border border-primary rounded-pill px-3 mb-3">$11 - $99</div>
                    @{ var title = item.TenHh ?? string.Empty; var shortTitle = title.Length > 40 ? title.Substring(0,40) + "..." : title; }
                    <h3 class="mb-3">@shortTitle</h3>
                    @{ 
                        var desc = item.MoTa ?? string.Empty;
                        var shortDesc = desc.Length > 150 ? desc.Substring(0, 150) + "..." : desc;
                    }
                    <span>@shortDesc</span>
                </div>
                <div class="position-relative mt-auto">
                    <img class="img-fluid" src="@item.ImageUrl" alt="@item.TenHh">
                    <div class="product-overlay d-flex justify-content-center">
                        <a class="btn btn-lg-square btn-outline-light rounded-circle me-2" href=""><i class="fa fa-eye text-primary"></i></a>
                        <form method="post" asp-controller="Cart" asp-action="AddToCart" class="d-inline-block">
                            <input type="hidden" name="maHh" value="@item.MaHh" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-sm btn-warning">Thêm vào giỏ</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
</div>

@{
    var currentPage = ViewBag.Page as int? ?? 1;
    var currentRecord = ViewBag.Record as int? ?? 9;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var maxNumbers = 9;
    var lastNumber = System.Math.Min(totalPages, maxNumbers);
    var isSearch = ViewBag.IsSearch ?? false;
    var keyword = ViewBag.Keyword ?? "";
}

<div class="d-flex justify-content-center align-items-center mt-4">
    <div>
        @for (int i = 1; i <= lastNumber; i++)
        {
            if (i == currentPage)
            {
                @if (isSearch)
                {
                    <a class="btn btn-sm btn-primary me-1" href="@Url.Action("Search", new { page = i, record = currentRecord, keyword = keyword })">@i</a>
                }
                else
                {
                    <a class="btn btn-sm btn-primary me-1" href="@Url.Action("Index", new { page = i, record = currentRecord })">@i</a>
                }
            }
            else
            {
                @if (isSearch)
                {
                    <a class="btn btn-sm btn-outline-primary me-1" href="@Url.Action("Search", new { page = i, record = currentRecord, keyword = keyword })">@i</a>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-primary me-1" href="@Url.Action("Index", new { page = i, record = currentRecord })">@i</a>
                }
            }
        }
    </div>
</div>
